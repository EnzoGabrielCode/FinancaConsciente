# Porta HTTP da API
PORT=3000

# Segredo para assinar os tokens JWT (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-longo

# Validade do token (formato do jsonwebtoken: 15m, 1h, 7d...)
JWT_EXPIRES_IN=1h

# Caminho do arquivo SQLite (a pasta é criada automaticamente)
DATABASE_PATH=./data/financaconsciente.db

# Custo do bcrypt (10 a 15; 12 é um bom padrão)
BCRYPT_ROUNDS=12

# Nível mínimo dos logs: error, warn, info, http, debug ou silent (desliga tudo).
# As requisições bem-sucedidas são registradas no nível http, abaixo de info:
# para vê-las, use LOG_LEVEL=http ou debug.
LOG_LEVEL=info
